model:
  version: 1
  kind: Table
  columns: []
pluginVersion: 1.0.0
filters:
  and:
    - file.path.startsWith("Study Notes/Programme/TERM_01")
    - file.ext == "canvas"
views:
  - type: cards
    name: Grid
    order:
      - file.basename
      - file.folder
    cardSize: 250
    imageAspectRatio: 0.55
