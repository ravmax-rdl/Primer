filters:
  and:
    - file.inFolder("Study Notes/BSc/S01_2026")
    - 'file.name == "Discrete Mathematics"'
    - 'file.path != "Study Notes/BSc/S01_2026/Discrete Mathematics/Discrete Mathematics.md"'
properties:
  note.date:
    displayName: Date
  note.week:
    displayName: Week
  note.day:
    displayName: Day
  note.status:
    displayName: Status
views:
  - type: table
    name: Lecture notes
    order:
      - file.link
      - note.date
      - note.week
      - note.day
      - note.status
    sort:
      - property: note.date
        direction: ASC
